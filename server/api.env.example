# ARCBANG API · Arc 主网环境变量样例
# 复制到 /etc/bnbbang/api.arc.env 后逐项填，chmod 600（路径与 server/arcbang-api.service 的
# EnvironmentFile 对上即可；那台机上还跑着别的实例，别覆盖它们各自的 env）。
# 本文件不含任何真实密钥。缺项时服务端会拒绝启动。
#
# 旧名兼容：server/env-compat.js 会把同名的 BNBBANG_* 复制成 ARCBANG_*，
# 所以线上那份还写着旧名的 env 不用马上改；两个都配时以 ARCBANG_* 为准。

# Arc 主网 chainId。必须显式写 5042。
ARCBANG_CHAIN_ID=5042

# Arc 主网 RPC（官方 primary；要 wss 或更高限速再加 Alchemy / QuickNode 的）。
ARCBANG_RPC=https://rpc.mainnet.arc.io

# eth_getLogs 实测单次上限 20000 条，索引器按块分页；同一节点即可。
ARCBANG_LOG_RPC=https://rpc.mainnet.arc.io

# ArcUniverse 主网地址（contracts/tools/deploy-arc.mjs 部署后打印）。签名绑死它，不配则拒绝启动。
ARCBANG_CONTRACT=

# MirrorMarket 无币版主网地址。v1 未部署，留空 = 市场页显示未部署。
ARCBANG_MARKET=

# ARCBANG 没有这些合约：命名 / 造物 / 返利金库一律留空。
ARCBANG_NAMES=
ARCBANG_NAMES2=
ARCBANG_CRAFTED=
ARCBANG_REFERRAL_VAULT=

# 合约部署高度（部署脚本打印的区块号），索引器从这里起扫。
ARCBANG_INDEX_FROM=

# 签名协议 v2：摘要末尾绑 minter。
ARCBANG_SIG_V2=1

# 对外域名（分享链接 / OG 用）。
ARCBANG_PUBLIC_BASE=https://arcbang.xyz

# 代码仓库地址。分享页 /s/<高度> 的页脚「Open source engine」指向它。
# 不配时 server/landing.js 里的默认值就是这一条，写出来是为了换仓库时有个地方可改。
ARCBANG_REPO_URL=https://github.com/q3579338/arcbang

# 站名。分享页 /s/<高度> 的左上角 watermark、<title> 后缀（「… | ARCBANG」）、
# og:site_name、ld+json 的 creator.name 都用它。
# 不配 = 这四处退回历史默认值 BNBBANG（分享到 X / Telegram 的预览卡片上站名也跟着错），**必须**配。
ARCBANG_BRAND=ARCBANG

# 链名。分享页的 H1（「Universe from Arc block #n」）、og:title、描述里的
# 「Every Arc block hash is a set of physical laws」、常数表第一行「Arc block」都用它。
# 不配 = 退回历史默认值，把 Arc 的区块写成「BNB block」—— 事实错误，**必须**配。
ARCBANG_CHAIN_WORD=Arc

# 静态站根目录（分享页要读 index.html 底稿）。
ARCBANG_WEBROOT=/var/www/arcbang

# ---- 卡死报告（前端看门狗 → POST /api/stall → 落盘 + 邮件通知）----
# 报告一律落盘到 .store/stall-reports.jsonl（一行一条，IP 只留前缀）。
# 下面三个只影响「要不要顺便发一封邮件」：不配 ARCBANG_RESEND_KEY 就只落盘，
# 启动日志里会写「卡死报告只落盘，未配邮件」。
#
# 收件地址。上线前要先在 Cloudflare 的 Email Routing 里把 admin@arcbang.xyz
# 转发到站长自己的邮箱，否则发出去也没人收。
ARCBANG_STALL_MAIL_TO=admin@arcbang.xyz
# 发件地址。域名必须是在 Resend 里验证过的（arcbang.xyz），否则会被拒。
ARCBANG_STALL_MAIL_FROM=stall@arcbang.xyz
# Resend 的 API key（re_ 开头）。在 resend.com 注册 → 验证 arcbang.xyz 域名 → 建 key。
# 留空 = 不发邮件，只落盘。
ARCBANG_RESEND_KEY=

# ---- 放号阶段与白名单（server/allowlist.js，2026-09-18 重做）----
# 原来那道「同一 IP 每天最多领 N 个免费签名」（ARCBANG_FREE_PER_IP_DAY）**已经删掉**：
# 上线 20 分钟，一个 IP 用 5 个新地址一分钟一枚薅走 5 枚，IP 是最便宜的东西。
# 现在免费与否由服务端按名单决定，并签进合约摘要（bangSigned 的 bool free）。
#
# 阶段：warmup（只预热，一张铸造签名都不签）/ gtd（只有保底层能铸，免费）
#       / fcfs（名单两层都能铸，免费额度先到先得）/ public（谁都能铸，默认付费）
ARCBANG_PHASE=warmup
# 到点自动往后切段（ISO 时间，可留空）。只前进不后退：不会把手动设的阶段拉回来。
ARCBANG_GTD_OPEN_AT=
ARCBANG_FCFS_OPEN_AT=
ARCBANG_PUBLIC_OPEN_AT=
# 登记码的盐。码 = HMAC(盐, 地址) 取 6 位大写字母数字，可复现，所以服务端不存码表。
# **换盐等于把所有已经发出去的码作废**，活动中途别动。
ARCBANG_ALLOWLIST_SALT=
# 任务要转发的那条置顶推。没配的话预热页只显示登记码和说明，不显示转发按钮。
ARCBANG_PINNED_POST_URL=
# 登记签名里写的域名。留空就从 ARCBANG_PUBLIC_BASE 取 host，再退回 arcbang.xyz。
# ---- X 三连 / 创作 / 里程碑 / 预热期 ----
# 关注与点赞在 X 上查不到，用户点一下就计分；转发那一项要贴回复链接，服务端自动核。
ARCBANG_PTS_FOLLOW=10
ARCBANG_PTS_LIKE=10
# 本站的 X 用户名（关注按钮要它）。
ARCBANG_X_HANDLE=arcbang_xyz
# 创作推文：提到本站 + 带 #ARCBANG + 不是转发，自动核过就计分。
ARCBANG_PTS_POST=20
ARCBANG_PTS_POST_PER_WEEK=2
ARCBANG_PTS_POST_MAX=5
# 邀请里程碑：在每人 20 分之外，攒到 3/5/10 人再各奖一笔（一档档累加）。
ARCBANG_PTS_INVITE_MILESTONES=3:30,5:50,10:100
# 预热期：填开始时间就够了，保底期没单独配时间时 = 开始 + 天数。
ARCBANG_WARMUP_START=
ARCBANG_WARMUP_DAYS=14
# 审核台（/admin.html）的口令。**口令与钱包地址一条都没配时整套后台接口回 404**（不是 401）。
ARCBANG_ADMIN_TOKEN=
# 能用钱包登录后台的地址（逗号分隔，大小写无所谓）。配了就能在审核台点「用钱包登录」：
# 签一条带域名 + 一次性 nonce 的话，换一枚 24 小时的会话令牌。口令那条路照常保留。
ARCBANG_ADMIN_ADDRS=
#
# ---- 用 X 登录 / 任务自动核 ----
# consumer key、secret、Bearer、Access Token 这四样**不在这里配** ——
# 它们存在 .store/xauth.json（0600），由管理员在 /admin.html 里粘贴。
# 走 env 的话那几串会留在 shell 历史、部署脚本和备份里。
# 这一段只有跑法上的参数：
# 自动核多久拉一轮（分钟）。
ARCBANG_XV_EVERY_MIN=10
# 每几轮做一次翻到底的全量。**只有全量那一轮发现得了退关、取消赞。**
ARCBANG_XV_FULL_EVERY=6
# 一条记录多少钱（Owned Reads，2026-02 起 $0.001）。只用来在后台算账。
ARCBANG_XV_PRICE=0.001
# 一轮最多翻几页的保险丝。接口给出环形 next_token 时不至于无限翻下去烧钱。
ARCBANG_XV_MAX_PAGES=50
ARCBANG_ALLOWLIST_DOMAIN=
#
# ---- 积分（名单按积分榜生成，不是人工一个个批）----
# 登记即得。
ARCBANG_PTS_REGISTER=10
# 转发置顶推 + 评论里回自己的登记码。**管理员 verify 打勾后才计**（X 评论人工核）。
ARCBANG_PTS_REPOST=30
# 有效邀请 = 被邀请人已经被 verify（光登记不算，否则造一百个地址就能刷分）。
ARCBANG_PTS_INVITE=20
ARCBANG_PTS_INVITE_MAX=20
# 引爆并分享：站内广播按钮生成链接时记一次，同地址同一天只算一次（UTC 日）。
ARCBANG_PTS_SHARE=5
ARCBANG_PTS_SHARE_MAX_DAYS=5
# 引爆计分：在模拟器里真引爆一个**真实 Arc 区块**就计分，同地址同区块只算一次。
# 两道上限都按**分**算，日界走 UTC。每地址每分钟最多入账 3 次（写死在代码里，防脚本狂刷）。
ARCBANG_PTS_BANG=1
ARCBANG_PTS_BANG_PER_DAY=10
ARCBANG_PTS_BANG_MAX=50
#
# ---- 公售价格公不公布 ----
# 0（默认）= 铸造页一个价格数字都不显示，哪怕链上读得到 price()；页面写「价格另行公布」。
# 公售开始那天置 1。**这是页面的开关，不影响合约**：合约里 price 仍是 1e18，
# 部署前可以用 setPrice 调。站点那一侧还有 web/config.arc.js 的 showPrice 跟它同义。
ARCBANG_SHOW_PRICE=0
#
# ---- 名额：名次 ≤ GTD_TOP 进保底层，≤ FREE_TOP 进先到先得层，其余不在名单 ----
# 排名 = 积分降序，同分按登记时间升序。GTD_TOP 会被夹到不超过 FREE_TOP。
ARCBANG_GTD_TOP=100
ARCBANG_FREE_TOP=387
#
# 三份文件在 ARCBANG_STORE 下：
#   allowlist-applied.jsonl  登记流水（只追加）
#   allowlist-state.json     转发勾与分享天数（会改写）
#   allowlist.json           **定格后**的名单 + 人工覆盖（条目永远赢）
# 日常只有两条命令：
#   node server/tools/allowlist.js applied --unverified   ← 待核的
#   node server/tools/allowlist.js verify <登记码或地址>   ← 打转发勾（+分，不发名额）
# **进保底期之前必须跑一次**，把当下的榜定格，之后名单不再随积分变：
#   node server/tools/allowlist.js freeze

# 部署向导门禁：只有这些 IP 打开 /deploy.html 才看到向导（逗号分隔；空 = 谁都看不到，只见状态页）。
# 站点根目录给 /deploy-gate 读 deploy.html / status.html 用。
ARCBANG_ADMIN_IPS=
ARCBANG_WEBROOT=/var/www/arcbang

# 签名私钥不写在这里：systemd unit 里 ARCBANG_SIGNER_KEY_FILE=/etc/arcbang/signer.key（600，属主 arcbang）。
