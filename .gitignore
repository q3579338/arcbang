# 依赖
node_modules/

# 构建产物（每次都能从源码重建，不入库）
dist/
web/dist/
web/dist-*/
contracts/out/*.runtime.hex
contracts/forge-out/

# 运行时数据与缓存（服务端落盘的存档、出图缓存）
server/.store/
server/.store-*/
server/.cache/
server/.cache-*/

# 真的环境变量与密钥：只有 *.example 进库
*.env
.env
.env.*
!*.env.example
api.env
api.env.*
!api.env.*.example
*.key
*.pem

# 私有材料（推广文案、申请稿、样张）：只在本机，不进公开仓
_private/

# 日志与草稿
*.log
*.jsonl
*.bak
scratchpad/

# 系统
.DS_Store
Thumbs.db

# 根目录下划线开头的临时脚本（agent 的验证脚本），不入库
/_*.js
/_*.html
